rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'username', 'email', 'firstName', 'lastName', 'age', 'contactNo'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'email', 'firstName', 'lastName', 'age', 'contactNo'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9._-]{3,30}$')
        && request.resource.data.email is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.age is int
        && request.resource.data.age >= 0
        && request.resource.data.age <= 120
        && request.resource.data.contactNo is string;
    }

    match /users/{userId} {
      allow read, delete: if ownsProfile(userId);
      allow create, update: if ownsProfile(userId) && validProfile(userId);
    }
  }
}